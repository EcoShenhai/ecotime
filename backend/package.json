    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jose": "5.10.0",
    "luxon": "3.7.2",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "rrule": "2.8.1",
    "sequelize": "6.37.8",
    "zod": "4.6.7"
  }
