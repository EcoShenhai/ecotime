{
  "name": "@ecotime/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "scheduler": "node src/jobs/schedulerWorker.js",
