# EcoTime settings: names only. The real file is backend/.env, created on the server, never committed.
# A machine-wide DATABASE_URL is ignored; ECOTIME_DATABASE_URL is the only override of DB_*.
NODE_ENV=production
PORT=4027
BIND_HOST=127.0.0.1
PUBLIC_BASE_URL=https://time.eshcloud.com
CORS_ORIGIN=https://time.eshcloud.com
DB_HOST=
DB_PORT=
DB_NAME=ecotime_db
DB_USER=ecotime_user
DB_PASSWORD=
DB_SSL=true
DB_POOL_MAX=5
ECOID_ISSUER=https://ecoid.eshcloud.com
ECOID_AUDIENCE=ecotime,ecotime-mobile
ECOID_ALLOW_NO_AUDIENCE=false
# 64 hex characters each (openssl rand -hex 32). DATA_KEY seals the operator's Authenticator secret and webhook secrets.
SESSION_JWT_SECRET=
REFRESH_TOKEN_PEPPER=
DATA_KEY=
# clock health (§9): the collector's state file, limits and the host label
CLOCK_STATE_FILE=/var/lib/ecotime-collector/clock-state.json
CLOCK_HOST_LABEL=ecocloud-prod-01
CLOCK_OBSERVATION_MAX_AGE_SECONDS=120
CLOCK_OFFSET_WARN_MS=50
CLOCK_ROOT_DISTANCE_WARN_MS=250
CLOCK_REQUIRE_SOURCE_DIVERSITY=false
TZDATA_VERSION_FILE=/usr/share/zoneinfo/tzdata.zi
# scheduler (§10)
SCHEDULER_LEASE_MS=60000
SCHEDULER_BATCH_SIZE=20
SCHEDULER_POLL_MS=5000
SCHEDULER_MAX_ATTEMPTS=4
SCHEDULER_ACTION_TIMEOUT_MS=10000
SCHEDULE_MIN_INTERVAL_MINUTES=5
SCHEDULE_EMAIL_MIN_INTERVAL_MINUTES=60
SCHEDULE_MAX_HORIZON_DAYS=3650
WEBHOOK_ALLOWED_DOMAINS=eshcloud.com,theshenhai.com
SUPPORT_APP_CODE=ECOTIME
SUPPORT_TICKET_PREFIX=ETM-
SUPPORT_EMAIL=support@theshenhai.com
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@time.eshcloud.com
SMTP_FROM_NAME=Shenhai EcoTime
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=300
